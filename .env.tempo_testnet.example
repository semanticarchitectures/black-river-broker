# .env.tempo_testnet
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.tempo_testnet and fill in your values.
# NEVER commit .env.tempo_testnet — it contains private keys.
#
# Tempo Moderato Testnet
#   RPC      : https://rpc.testnet.tempo.xyz  (returns chain ID 42431)
#   Chain ID : 42431
#   Explorer : https://explorer.testnet.tempo.xyz
#   Faucet   : https://faucet.tempo.xyz
#   Gas token: pathUSD (from faucet — no ETH needed)
# ─────────────────────────────────────────────────────────────────────────────

# ── Network ──────────────────────────────────────────────────────────────────
TEMPO_TESTNET_RPC=https://rpc.testnet.tempo.xyz

# ── Wallets (private keys — use testnet keys only) ────────────────────────────
# The deployer pays gas for contract deployment.  Must be funded via faucet.
DEPLOYER_PRIVATE_KEY=0x<your-deployer-private-key>

# The broker wallet signs on-chain transactions during procurement.
# Can be the same as the deployer for testnet convenience.
BROKER_PRIVATE_KEY=0x<your-broker-private-key>

# Producer wallets receive USDC when a contract is settled.
# Leave blank to skip producer wallet funding during deploy.
PRODUCER_AEROPLAN_KEY=0x<aeroplan-producer-private-key>
PRODUCER_SKYWATCH_KEY=0x<skywatch-producer-private-key>

# The consumer wallet pays the MPP challenge to unlock /procure.
# Used by agents/consumer/mpp_consumer.py
CONSUMER_PRIVATE_KEY=0x<your-consumer-private-key>

# ── MPP Broker Server ─────────────────────────────────────────────────────────
# Port the FastAPI MPP broker server listens on.
MPP_SERVER_PORT=8000
# Public URL of the broker server (used in MPP service discovery).
MPP_SERVER_URL=http://localhost:8000

# ── AI (optional — skipped in dry-run and when absent) ───────────────────────
ANTHROPIC_API_KEY=

# ── Written by deploy_tempo_testnet.js (do not edit manually) ────────────────
BROKER_WALLET=
MOCK_USDC_ADDRESS=
AUDIT_LOG_ADDRESS=
BROKER_CONTRACT_ADDRESS=
PRODUCER_AEROPLAN_WALLET=
PRODUCER_SKYWATCH_WALLET=
CONSUMER_WALLET=
